<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/ceyo_widget_bg" android:layoutDirection="rtl">
    <ImageView android:id="@+id/w_robot" android:layout_width="58dp" android:layout_height="58dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="Ceyo"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/w_mood" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/w_talk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎙 اتكلم" android:textColor="#000000" android:textSize="13sp" android:background="@drawable/ceyo_pill" android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
        <TextView android:id="@+id/w_memo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="💡 فكرة" android:textColor="#000000" android:textSize="13sp" android:background="@drawable/ceyo_pill" android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
    </LinearLayout>
</LinearLayout>
